datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model DayEntry {
  id        String   @id @default(cuid())
  date      DateTime @unique

  // SQLite: keine Prisma-Enms -> wir speichern Strings
  zodiac    String   @default("OTHER") // LOEWE, JUNGFRAU, FISCHE, KREBS, SKORPION, STEINBOCK, OTHER
  phase     String   @default("OTHER") // NEW, FIRST_QUARTER, FULL, LAST_QUARTER, OTHER

  hnw       Boolean  @default(false)   // Haare nicht waschen
  note      String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
